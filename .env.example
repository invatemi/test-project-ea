APP_NAME="WB API Test"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Moscow

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel DB (в Docker: DB_HOST=mysql, с хоста: DB_HOST=127.0.0.1)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wb_api_test
DB_USERNAME=root
DB_PASSWORD=change_me

# Docker MySQL (нестандартный порт на хосте)
MYSQL_BIND_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=change_me

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# WB API (чувствительные и конфигурационные данные)
WB_API_HOST=http://109.73.206.144:6969
WB_API_KEY=
WB_API_LIMIT=500
WB_API_REQUEST_DELAY_MS=1100
WB_API_MAX_RETRIES=15
WB_API_DATE_FROM=2020-01-01
WB_API_DATE_TO=2025-12-31
WB_API_FRESH_BUFFER_DAYS=1
WB_API_DEFAULT_SERVICE=wb_test

# Планировщик: часы запуска импорта (2 раза в день)
IMPORT_SCHEDULE_TIMES=8,20
